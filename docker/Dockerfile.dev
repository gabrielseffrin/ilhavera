# Imagem de desenvolvimento: a única superfície de execução do projeto.
# O host não precisa de pnpm — tudo roda via `docker compose exec app pnpm <script>`.
FROM node:22-bookworm-slim

# git: turbo detecta mudanças por git
# ca-certificates: pnpm baixa pacotes por HTTPS
RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

# Store do pnpm fora do bind mount — ver os volumes nomeados em docker-compose.yml.
# Via env var (e não no .npmrc do repo) para o .npmrc continuar válido no CI.
ENV NPM_CONFIG_STORE_DIR=/pnpm-store
RUN mkdir -p /pnpm-store

WORKDIR /workspace

CMD ["sleep", "infinity"]
